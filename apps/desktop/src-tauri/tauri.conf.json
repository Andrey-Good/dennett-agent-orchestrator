{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dennett",
  "version": "0.1.0",
  "identifier": "dev.dennett.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dennett",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "theme": "Dark",
        "windowEffects": {
          "effects": ["mica"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
